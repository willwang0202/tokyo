# Supabase connection for the shared buy list.
#
# Copy to .env.local for local development (gitignored). For the GitHub Pages
# deploy, set the same two names as repository secrets — the build workflow
# reads them from there.
#
# Both values are safe to expose in the built bundle: the key is designed to be
# public, and Row Level Security is what actually enforces the rules
# (see supabase/migrations/).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
